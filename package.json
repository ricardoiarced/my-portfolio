{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Ricardo Arce's software development portfolio",
  "scripts": {
    "dev": "astro dev",
    "start": "node scripts/static-server.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "for file in scripts/*.mjs tests/*.mjs; do node --check \"$file\" || exit 1; done",
    "check:astro": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:links": "node scripts/check-external-links.mjs",
    "test:browser": "playwright test tests/release-browser.spec.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "release:check": "npm run build && npm run check:astro && npm test && npm run check && npm run test:links && npm run test:browser && npm run audit:lighthouse",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardoiarced/my-portfolio.git"
  },
  "author": "Ricardo Arce",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ricardoiarced/my-portfolio/issues"
  },
  "homepage": "https://ricardoiarced.github.io/my-portfolio/",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.55.1",
    "astro": "^7.3.5",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
