{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Ricardo Arce's software development portfolio",
  "scripts": {
    "dev": "astro dev",
    "start": "node scripts/static-server.ts",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --project tsconfig.node.json",
    "check:astro": "astro check",
    "test": "node --test tests/*.test.ts",
    "test:links": "node scripts/check-external-links.ts",
    "test:browser": "playwright test tests/release-browser.spec.ts",
    "audit:lighthouse": "node scripts/lighthouse-audit.ts",
    "release:check": "npm run check && npm run build && npm test && npm run test:links && npm run test:browser && npm run audit:lighthouse",
    "verify:production": "node scripts/verify-production.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardoiarced/my-portfolio.git"
  },
  "author": "Ricardo Arce",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ricardoiarced/my-portfolio/issues"
  },
  "homepage": "https://ricardoiarced.github.io/my-portfolio/",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.60.0",
    "@types/node": "^26.6.6",
    "astro": "^7.3.5",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  }
}
