---
import "../styles/portfolio.css";
import "../styles/lateral.css";
import { sections, sectionAliases } from "../data/sections";
import { github, linkedin } from "../data/portfolio";
import { initializeNavigation } from "../scripts/initialize-navigation";

const navigationBootstrap = `(${initializeNavigation.toString()})(${JSON.stringify(sections.map(section => section.id))}, ${JSON.stringify(sectionAliases)});`;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const title = "Ricardo Arce | Software Engineer";
const description = "Ricardo Arce is a software engineer focused on reliable, accessible, and maintainable web applications.";
const url = "https://ricardoiarced.github.io/my-portfolio/";
const socialImage = `${url}img/social-preview.jpg`;
const person = {
  "@context": "https://schema.org", "@type": "Person", name: "Ricardo Arce", url,
  jobTitle: "Software Engineer", description, sameAs: [github, linkedin],
  knowsAbout: ["Python", "Odoo", "Systems integration", "Accessible web applications"],
  address: { "@type": "PostalAddress", addressLocality: "Hermosillo", addressRegion: "Sonora", addressCountry: "MX" },
};
---
<!doctype html>
<html lang="en" style={`--count: ${sections.length}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f10" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={title} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ricardo Arce — reliable, accessible, and maintainable web applications" />
    <meta property="profile:first_name" content="Ricardo" />
    <meta property="profile:last_name" content="Arce" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Ricardo Arce — reliable, accessible, and maintainable web applications" />
    <link rel="icon" href={`${base}img/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}img/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline set:html={navigationBootstrap} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>import "../scripts/lateral-nav";</script>
  </body>
</html>
