---
import { experience } from "../../data/portfolio";
const { base } = Astro.props;
---
<div class="section-heading"><h2>Experience</h2><a class="micro subtle-link" href={`${base}assets/ricardo-arce-resume.pdf`} download>Résumé <span aria-hidden="true">↓</span></a></div>
{experience.map(job => <article class="quiet-job">
  <div class="quiet-job-period"><p class="micro job-dates">{job.dates}</p><p class="micro job-location">{job.location}</p></div>
  <div>
    <h3>{job.role}</h3><p class="company">{job.company}</p><p class="job-description">{job.description}</p>
    <ul class="experience-highlights">{job.highlights.map(highlight => <li>{highlight}</li>)}</ul>
    {job.additional.length > 0 && <details class="experience-more"><summary aria-label={`More contributions at ${job.company}`}>More contributions</summary><ul class="experience-highlights">{job.additional.map(highlight => <li>{highlight}</li>)}</ul></details>}
    <p class="stack experience-stack">{job.stack}</p>
  </div>
</article>)}
