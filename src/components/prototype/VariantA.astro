---
import { projects, experience, email, github, linkedin } from "./data";
const { base } = Astro.props;
---
<div class="quiet-shell">
  <header class="quiet-header">
    <a class="wordmark" href="#top" aria-label="Ricardo Arce, back to top">ra<span>.</span></a>
    <nav aria-label="Main navigation"><a href="#featured-projects">Projects</a><a href="#experience">Experience</a><a href="#contact">Contact <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main id="main-content" tabindex="-1">
    <header class="quiet-intro">
      <p class="micro"><span class="status-dot" aria-hidden="true"></span> Software developer · Puerto Vallarta, MX</p>
      <h1>Ricardo Arce<span>.</span></h1>
      <p class="quiet-statement">Thoughtful software.<br /><span>Useful in the everyday.</span></p>
      <p class="intro-copy">I build web applications and business systems that make complex work feel simple.</p>
      <a class="text-link" href={`mailto:${email}`}>Get in touch <span aria-hidden="true">↗</span></a>
    </header>

    <section class="quiet-section" id="featured-projects" aria-labelledby="quiet-projects">
      <div class="section-heading"><h2 id="quiet-projects">Selected projects</h2><span class="micro">01 — 03</span></div>
      <div class="quiet-projects">
        {projects.map((project, index) => <a class="quiet-project" href={`${base}projects/${project.slug}.html`}>
          <span class="entry-number">0{index + 1}</span>
          <div><h3>{project.title}</h3><p>{project.description}</p><span class="stack">{project.stack}</span></div>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>

    <section class="quiet-section" id="experience" aria-labelledby="quiet-experience">
      <div class="section-heading"><h2 id="quiet-experience">Experience</h2><a class="micro subtle-link" href={`${base}assets/CV_ARCE_DIAZ_RICARDO_IRVIN.pdf`} download>Résumé <span aria-hidden="true">↓</span></a></div>
      {experience.map(job => <article class="quiet-job">
        <p class="micro job-dates">{job.years}</p>
        <div><h3>{job.role}</h3><p class="company">{job.company}</p><p class="job-description">{job.description}</p></div>
      </article>)}
    </section>

    <section class="quiet-section quiet-contact" id="contact" aria-labelledby="quiet-contact">
      <h2 class="micro" id="quiet-contact">Have something in mind?</h2>
      <a class="contact-title" href={`mailto:${email}`}>Let’s talk<span aria-hidden="true">↗</span></a>
      <div class="quiet-contact-bottom"><a class="email-link" href={`mailto:${email}`}>{email}</a><div class="social-links"><a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
    </section>
  </main>
</div>
