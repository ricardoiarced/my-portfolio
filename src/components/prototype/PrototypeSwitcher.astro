---
// Shared throwaway switcher; the parent route only mounts this in development.
---
{import.meta.env.DEV && <aside class="prototype-switcher" aria-label="Portfolio design comparison">
  <span class="prototype-badge">Design prototype</span>
  <div class="prototype-controls"><button type="button" data-prototype-previous aria-label="Previous design">←</button><div class="prototype-label" role="status" aria-live="polite"><strong data-prototype-label>A · Quiet index</strong><span data-prototype-description>Text first · one column · lime accent</span></div><button type="button" data-prototype-next aria-label="Next design">→</button></div>
  <span class="prototype-count" data-prototype-count>1 / 3</span>
</aside>}
