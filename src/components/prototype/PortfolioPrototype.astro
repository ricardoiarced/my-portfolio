---
// PROTOTYPE QUESTION: which minimal dark layout best presents Ricardo's work?
// Three designs on the existing homepage, selected with ?variant=A|B|C.
import VariantA from "./VariantA.astro";
import VariantB from "./VariantB.astro";
import VariantC from "./VariantC.astro";
import PrototypeSwitcher from "./PrototypeSwitcher.astro";
const { base } = Astro.props;
---
<!doctype html>
<html lang="en" data-portfolio-variant="A">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d0f10" />
    <title>Portfolio design prototypes | Ricardo Arce</title>
    <link rel="icon" href={`${base}img/icon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}prototypes/portfolio.css`} />
    <script is:inline>
      // Set before paint; invalid values fall back to A.
      const requestedVariant = new URL(location.href).searchParams.get("variant");
      document.documentElement.dataset.portfolioVariant = ["A", "B", "C"].includes(requestedVariant) ? requestedVariant : "A";
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <template data-prototype-template="A"><VariantA base={base} /></template>
    <template data-prototype-template="B"><VariantB base={base} /></template>
    <template data-prototype-template="C"><VariantC base={base} /></template>
    <div id="prototype-canvas"></div>
    <PrototypeSwitcher />
    <script is:inline src={`${base}prototypes/portfolio.js`}></script>
  </body>
</html>
