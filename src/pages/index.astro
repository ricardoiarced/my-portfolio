---
// Throwaway comparison on the existing homepage: ?variant=A|B|C.
import DocumentHomepage from "../components/DocumentHomepage.astro";
import PortfolioPrototype from "../components/prototype/PortfolioPrototype.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// Static Astro pages do not receive URL search params on the server.
// In development the client selects the variant; builds use the real homepage.
const showPrototype = import.meta.env.DEV;
const Homepage = showPrototype ? PortfolioPrototype : DocumentHomepage;
---

<Homepage base={base} />
